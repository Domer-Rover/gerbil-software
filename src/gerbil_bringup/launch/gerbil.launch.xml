<launch>
    <!-- ==================== ARGUMENTS ==================== -->
    <!-- false = talk to the real RoboClaw. Was true, which meant launching
         this file DIRECTLY (rather than via the foxglove/nav2 wrappers, which
         both already pass false) gave a simulated robot with no warning:
         wheels still, odometry integrating perfectly, real /scan. Defaults
         should give the real robot; ask for the simulation explicitly. -->
    <arg name="use_mock_hardware" default="false" />
    <arg name="use_duty_cycle" default="true" description="false = RoboClaw velocity PID (needs encoders + tuned PID)" />
    <arg name="serial_port" default="/dev/gerbil_roboclaw" />
    <arg name="lidar_port" default="/dev/gerbil_lidar" />  <!-- needs udev/99-gerbil.rules installed -->
    <arg name="use_twist_mux" default="true" description="arbitrate joystick / keyboard / nav2. Needs ros-humble-twist-mux. Turn OFF only to drive a single source straight into the controller." />
    <arg name="launch_lidar" default="true" />
    <arg name="launch_gps" default="false" />
    <arg name="launch_rviz" default="false" />  <!-- needs a display; off for headless SSH -->
    <arg name="launch_zed" default="true" />
    <!-- Start joy_node and teleop_twist_joy in this launch, the way Capybara
         does, so one command brings up the robot and the pad. Default false so
         a bare launch is unchanged and nothing grabs the joystick device
         unasked. twist_mux still arbitrates; this publishes to /cmd_vel_joy
         exactly like teleop_joystick.sh, so the pad keeps priority 100 and
         still overrides Nav2. Do NOT run teleop_joystick.sh at the same time,
         two teleop_twist_joy instances would both publish and fight. -->
    <arg name="use_joystick" default="false" description="bring up the pad in this launch (publishes to /cmd_vel_joy)" />

    <!-- ==================== SIMULATION ARGS ==================== -->
    <!-- Everything below exists so gerbil_gazebo/sim.launch.py can run THIS
         file instead of a fork of it. Every default is the real robot, so a
         launch that does not mention them is unchanged. See
         gerbil_gazebo/README.md for the contract. -->
    <!-- Handed to every node we start. true only under Gazebo, where /clock
         comes from the bridge. -->
    <arg name="use_sim_time" default="false" description="true = follow /clock (Gazebo). Real robot: false" />
    <!-- Passed straight to xacro. none = real or mock hardware, as before.
         gazebo = ign_ros2_control plus the sensor plugins. -->
    <arg name="sim_mode" default="none" description="xacro sim_mode: none (real or mock hardware) or gazebo" />
    <arg name="sim_depth_camera" default="false" description="xacro sim_depth_camera: add the simulated ZED depth cloud (sim_mode gazebo only)" />
    <!-- In Gazebo the controller_manager lives INSIDE the ign_ros2_control
         plugin, so a second one from ros2_control_node would fight it for the
         same /controller_manager name and own no hardware. -->
    <arg name="launch_ros2_control_node" default="true" description="false under Gazebo, where the ign_ros2_control plugin is the controller_manager" />
    <!-- The sim launch starts the spawners itself, and only once the robot
         exists in Gazebo, because the plugin's controller_manager does not
         exist before then. -->
    <arg name="launch_spawners" default="true" description="spawn joint_state_broadcaster and diff_drive_controller here" />
    <!-- launch_lidar gates the whole LIDAR chain. launch_lidar_driver gates
         only the LD19 driver, so the laser_filters chain can still turn a
         simulated /scan_raw into /scan. -->
    <arg name="launch_lidar_driver" default="true" description="start the LD19 driver. false = /scan_raw comes from elsewhere (Gazebo bridge, a bag)" />

    <!-- ==================== PATHS ==================== -->
    <let name="urdf_path"
         value="$(find-pkg-share gerbil_description)/urdf/gerbil.urdf.xacro" />
    <let name="rviz_config_path"
         value="$(find-pkg-share gerbil_description)/rviz/urdf_config.rviz" />
    <!-- One xacro command line, shared by robot_state_publisher and
         ros2_control_node so the two can never disagree. With sim_mode none
         and sim_depth_camera false (the xacro defaults) the generated URDF
         is byte for byte what it was before these args existed. -->
    <let name="xacro_cmd"
         value="xacro $(var urdf_path) use_mock_hardware:=$(var use_mock_hardware) use_duty_cycle:=$(var use_duty_cycle) serial_port:=$(var serial_port) sim_mode:=$(var sim_mode) sim_depth_camera:=$(var sim_depth_camera)" />

    <!-- ==================== ROBOT STATE PUBLISHER ==================== -->
    <!-- Keep the default node name robot_state_publisher. Under Gazebo the
         ign_ros2_control plugin reads robot_description from a node of
         exactly that name. -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <!-- type="str" is REQUIRED. Without it launch parses this value with
             YAML rules, and xacro copies XML comments through into the
             generated URDF, so a single ": " inside any comment (e.g.
             "Acrylic deck: a thin plate") makes YAML read it as a mapping key
             and the whole launch fails with "Failed to convert ... using yaml
             rules". type="str" passes the URDF through verbatim. -->
        <param name="robot_description" type="str"
               value="$(command '$(var xacro_cmd)')" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
    </node>

    <!-- ==================== ROS2 CONTROL ==================== -->
    <group if="$(var launch_ros2_control_node)">
        <node pkg="controller_manager" exec="ros2_control_node" output="screen">
            <!-- type="str" is REQUIRED. Without it launch parses this value with
                 YAML rules, and xacro copies XML comments through into the
                 generated URDF, so a single ": " inside any comment (e.g.
                 "Acrylic deck: a thin plate") makes YAML read it as a mapping key
                 and the whole launch fails with "Failed to convert ... using yaml
                 rules". type="str" passes the URDF through verbatim. -->
            <param name="robot_description" type="str"
                   value="$(command '$(var xacro_cmd)')" />
            <param from="$(find-pkg-share gerbil_bringup)/config/gerbil_controllers.yaml" />
            <param name="use_sim_time" value="$(var use_sim_time)" />
        </node>
    </group>

    <!-- Spawners for controllers. Left on wall time on purpose: they only
         wait on services, and a spawner on sim time would stall if /clock
         were late. -->
    <group if="$(var launch_spawners)">
        <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster" />
        <node pkg="controller_manager" exec="spawner" args="diff_drive_controller" />
    </group>

    <!-- ==================== ZED2i CAMERA ==================== -->
    <group if="$(var launch_zed)">
        <include file="$(find-pkg-share zed_wrapper)/launch/zed_camera.launch.py">
            <!-- sim_mode and use_sim_time MUST be passed explicitly. Launch
                 configurations leak into an include, and the ZED launch
                 declares its own sim_mode (ZED SDK simulator input) with
                 choices true or false only. Without this line it inherits
                 OUR sim_mode, the value none is rejected, and the real
                 robot fails to launch. Theirs and ours are unrelated. -->
            <arg name="sim_mode" value="false" />
            <arg name="use_sim_time" value="$(var use_sim_time)" />
            <arg name="camera_model" value="zed2i" />
            <arg name="publish_urdf" value="true" />
            <arg name="publish_tf" value="false" />  <!-- EKF owns odom -> base_footprint -->
            <arg name="publish_map_tf" value="false" />
            <!-- Our deviations from the VENDORED zed config. The wrapper loads
                 common_stereo.yaml then zed2i.yaml, both under
                 src/vendors/zed_wrapper and both overwritten by an SDK or
                 wrapper upgrade, so settings edited into them revert silently.
                 This file is appended last and wins over both. -->
            <arg name="ros_params_override_path"
                 value="$(find-pkg-share gerbil_bringup)/config/zed_override.yaml" />
        </include>
    </group>

    <!-- ==================== RVIZ ==================== -->
    <group if="$(var launch_rviz)">
        <node pkg="rviz2" exec="rviz2" output="screen"
              args="-d $(var rviz_config_path)">
            <param name="use_sim_time" value="$(var use_sim_time)" />
        </node>
    </group>
    <!-- ==================== LIDAR (LD19) ==================== -->
    <!-- Driver publishes /scan_raw; laser_filters crops the robot body and
         the rear half, publishing /scan for Nav2. Under Gazebo the driver is
         off (launch_lidar_driver false) and the bridge publishes /scan_raw
         instead, so the SAME filter chain and bounds produce /scan. -->
    <group if="$(var launch_lidar)">
        <node if="$(var launch_lidar_driver)" pkg="ldlidar_stl_ros2" exec="ldlidar_stl_ros2_node" name="ldlidar_node" output="screen">
            <param name="product_name" value="LDLiDAR_LD06" />
            <param name="topic_name" value="scan_raw" />
            <param name="port_name" value="$(var lidar_port)" />
            <param name="port_baudrate" value="230400" />
            <param name="laser_scan_dir" value="true" />
            <param name="frame_id" value="laser_frame" />
            <param name="use_sim_time" value="$(var use_sim_time)" />
        </node>
        <node pkg="laser_filters" exec="scan_to_scan_filter_chain" output="screen">
            <param from="$(find-pkg-share gerbil_bringup)/config/laser_filter.yaml" />
            <param name="use_sim_time" value="$(var use_sim_time)" />
            <remap from="scan" to="scan_raw" />
            <remap from="scan_filtered" to="scan" />
        </node>
    </group>

    <!-- ==================== GPS (u-blox) ==================== -->
    <group if="$(var launch_gps)">
        <node pkg="ublox_gps" exec="ublox_gps_node" name="gps" output="screen">
            <param name="device" value="/dev/gerbil_gps" />
            <param name="frame_id" value="gps" />
            <param name="uart1.baudrate" value="38400" />
            <param name="publish.nav.posllh" value="true" />
            <param name="publish.nav.status" value="true" />
            <param name="publish.nav.pvt" value="true" />
            <param name="use_sim_time" value="$(var use_sim_time)" />
        </node>
    </group>

    <!-- ==================== EKF (odom -> base_footprint) ==================== -->
    <node pkg="robot_localization" exec="ekf_node" name="ekf_filter_node" output="screen">
        <param from="$(find-pkg-share gerbil_bringup)/config/ekf.yaml" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
    </node>

    <!-- ==================== COMMAND ARBITRATION ==================== -->
    <!-- Every velocity source publishes to its OWN topic and twist_mux picks a
         winner by priority, writing the result to the controller. Without this
         nav2 and the joystick both wrote to the controller topic directly and
         the robot obeyed whichever message was most recent.
         Priorities live in config/twist_mux.yaml: joystick 100 > keyboard 90 >
         nav2 10. -->
    <group if="$(var use_twist_mux)">
        <node pkg="twist_mux" exec="twist_mux" name="twist_mux" output="screen">
            <param from="$(find-pkg-share gerbil_bringup)/config/twist_mux.yaml" />
            <param name="use_sim_time" value="$(var use_sim_time)" />
            <remap from="cmd_vel_out" to="/diff_drive_controller/cmd_vel_unstamped" />
        </node>
    </group>

    <!-- ==================== JOYSTICK (use_joystick:=true) ==================== -->
    <!-- Values match scripts/teleop_joystick.sh and teleop_common.sh so the pad
         feels identical whichever way it is started. Hold L1 (button 4) as the
         deadman, then the left stick drives. autorepeat_rate republishes a HELD
         stick so it does not go stale against twist_mux's 0.5 s timeout.
         device_id is the SDL index, NOT a device path. joy_node in Humble is
         SDL2 based and device_name wants the pad's SDL name. -->
    <group if="$(var use_joystick)">
        <node pkg="joy" exec="joy_node" name="joy_node" output="screen">
            <param name="device_id" value="0" />
            <param name="autorepeat_rate" value="20.0" />
            <param name="deadzone" value="0.05" />
            <param name="use_sim_time" value="$(var use_sim_time)" />
        </node>
        <node pkg="teleop_twist_joy" exec="teleop_node" name="teleop_twist_joy" output="screen">
            <param name="enable_button" value="4" />
            <param name="axis_linear.x" value="1" />
            <param name="scale_linear.x" value="0.3" />
            <param name="axis_angular.yaw" value="0" />
            <param name="scale_angular.yaw" value="1.0" />
            <param name="use_sim_time" value="$(var use_sim_time)" />
            <remap from="cmd_vel" to="/cmd_vel_joy" />
        </node>
    </group>

    <!-- ==================== TELEOP ====================
         Neither joystick nor keyboard teleop is launched here. Both need a
         terminal of their own: teleop_twist_keyboard reads raw stdin, and the
         joystick is plugged in and unplugged independently of the robot stack,
         so restarting everything to attach a pad was wasteful. Run whichever
         you want in a second terminal:

           ros2 run gerbil_bringup teleop_keyboard.sh
           ros2 run gerbil_bringup teleop_joystick.sh

         Both publish to their twist_mux input topic and share their speed
         settings from scripts/teleop_common.sh, so they feel identical.
         twist_mux above is what forwards them to the controller. -->

    <!-- ==================== KEYBOARD TELEOP ==================== -->
    <!-- Deliberately NOT launched here. teleop_twist_keyboard reads raw stdin,
         so it only works when it owns a terminal; started from a launch file
         it captures no keys. Run it yourself in a second terminal, with the
         speeds matched to the joystick above. The exact command is in
         gerbil_bringup/README or run:
           ros2 run teleop_twist_keyboard teleop_twist_keyboard
         with ros-args remapping cmd_vel to /cmd_vel_key and params
         speed:=0.3 turn:=1.0  (an XML comment cannot contain a double hyphen,
         which is why the flags are spelled out rather than shown literally).

         twist_mux gives it priority 90, so it overrides nav2 but yields to
         the joystick. -->
</launch>
