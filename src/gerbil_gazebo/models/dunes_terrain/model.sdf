<?xml version="1.0"?>
<!-- GENERATED by scripts/fetch_dem.py (site indiana_dunes). West Beach, Indiana Dunes National Park, Indiana (beach, foredune and interdunal flat, with the toe of a large dune at the south edge).
     200 x 200 m USGS 3DEP DEM heightmap, heights shifted so the lowest point is z = 0
     (relief 14.482 m). See README.md for the source and elevations. -->
<sdf version="1.8">
  <model name="dunes_terrain">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <heightmap>
            <uri>model://dunes_terrain/dem/indiana_dunes_dem.tif</uri>
            <size>200 200 14.482</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
        <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry>
          <heightmap>
            <use_terrain_paging>false</use_terrain_paging>
            <texture>
              <diffuse>model://dunes_terrain/materials/textures/sand_diffuse.png</diffuse>
              <normal>model://dunes_terrain/materials/textures/sand_normal.png</normal>
              <size>8</size>
            </texture>
            <uri>model://dunes_terrain/dem/indiana_dunes_dem.tif</uri>
            <size>200 200 14.482</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
