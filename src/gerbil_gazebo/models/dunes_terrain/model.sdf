<?xml version="1.0"?>
<!-- GENERATED by scripts/dem_to_mesh.py from dem/*_dem.tif (see README.md for the source).
     200 x 200 m terrain, lowest point z = 0, relief 14.400 m. A mesh, not a
     heightmap - Fortress cannot load a float DEM as a physics heightmap. -->
<sdf version="1.8">
  <model name="dunes_terrain">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><mesh><uri>model://dunes_terrain/meshes/terrain.obj</uri></mesh></geometry>
        <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><mesh><uri>model://dunes_terrain/meshes/terrain.obj</uri></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
