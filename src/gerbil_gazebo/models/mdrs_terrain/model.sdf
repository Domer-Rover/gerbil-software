<?xml version="1.0"?>
<!-- GENERATED by scripts/fetch_dem.py (site mdrs_utah). MDRS / University Rover Challenge site, near Hanksville, Utah.
     200 x 200 m USGS 3DEP DEM heightmap, heights shifted so the lowest point is z = 0
     (relief 12.794 m). See README.md for the source and elevations. -->
<sdf version="1.8">
  <model name="mdrs_terrain">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <heightmap>
            <uri>model://mdrs_terrain/dem/mdrs_utah_dem.tif</uri>
            <size>200 200 12.794</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry>
          <heightmap>
            <use_terrain_paging>false</use_terrain_paging>
            <texture>
              <diffuse>model://mdrs_terrain/materials/textures/desert_diffuse.png</diffuse>
              <normal>model://mdrs_terrain/materials/textures/desert_normal.png</normal>
              <size>8</size>
            </texture>
            <uri>model://mdrs_terrain/dem/mdrs_utah_dem.tif</uri>
            <size>200 200 12.794</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
