<?xml version="1.0"?>
<!-- Trash can, 0.4 m diameter x 0.7 m.
     Static, primitive collisions. The model origin is the centre of its footprint on the
     ground (z = 0 is the floor). Spawn with scripts/spawn_obstacle.sh. -->
<sdf version="1.8">
  <model name="trash_can">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.35 0 0 0</pose>
        <geometry><cylinder><radius>0.2</radius><length>0.7</length></cylinder></geometry>
      </collision>
      <visual name="body">
        <pose>0 0 0.34 0 0 0</pose>
        <geometry><cylinder><radius>0.2</radius><length>0.68</length></cylinder></geometry>
        <material><ambient>0.1 0.35 0.9 1</ambient><diffuse>0.1 0.35 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="lid">
        <pose>0 0 0.69 0 0 0</pose>
        <geometry><cylinder><radius>0.205</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
    </link>
  </model>
</sdf>
