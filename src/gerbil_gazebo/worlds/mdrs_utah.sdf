      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.88 0.82 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.3 -0.8</direction>
    </light>

    <include>
      <uri>model://mdrs_terrain</uri>
      <name>terrain</name>
      <pose>0 0 0 0 0 0</pose>
