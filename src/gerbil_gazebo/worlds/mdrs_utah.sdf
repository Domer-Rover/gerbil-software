<?xml version="1.0"?>
<!--
  mdrs_utah: MDRS / University Rover Challenge site, near Hanksville, Utah.
  GENERATED by scripts/fetch_dem.py (site mdrs_utah) - edit the script, not this file.
  Terrain: model://mdrs_terrain (USGS 3DEP DEM as a triangle mesh, relief 12.794 m, lowest point z = 0).
  +x is east, +y is north, the origin is the patch centre (38.405471, -110.790016).
  Spawn (config/worlds.yaml): x=-2 y=0 z=1.5534, on the flattest spot near the centre.
  Physics: 4 ms steps (250 Hz) = 5 steps per 50 Hz ros2_control update, like school_loop.
  DART uses the ODE collision detector, which handles the wheel cylinders and the terrain trimesh well.
  Rendering: one directional light, no shadows, no sky; obstacles are primitives.
-->
<sdf version="1.8">
  <world name="mdrs_utah">
    <physics name="terrain_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <dart><collision_detector>ode</collision_detector></dart>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>38.40547139</latitude_deg>
      <longitude_deg>-110.79001631</longitude_deg>
      <elevation>1368.0809</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.62 0.75 0.9 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
