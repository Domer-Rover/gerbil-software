<?xml version="1.0"?>
<!--
  basement_loop: rectangular ring corridor around a solid classroom block.
  GENERATED by scripts/gen_loop_world.py - edit the script, not this file.
  Args: outer-length 20, outer-width 20, corridor 2.44, wall-height 2.4, doors 0, step 0.004

  Outer (clear) size 20 x 20 m, corridor 2.44 m clear everywhere (door recesses only widen it),
  classroom block 15.12 x 15.12 m, walls 2.4 m high.
  LAP LENGTH along the corridor centreline: 70.24 m (17.56 x 17.56 m rectangle).
  Spawn (config/worlds.yaml): x=0 y=-8.78 yaw=0, mid south corridor facing +x;
  driving forward laps counter-clockwise. The yellow line on the floor marks the start.

  Physics: 4 ms steps at real_time_factor 1.0 (250 Hz). ros2_control runs at 50 Hz, i.e.
  exactly one controller update every 5 physics steps, and the 10 Hz LiDAR and 25 Hz
  odometry also land on whole steps. 4 ms is stable for a small diff-drive base on DART
  and costs half the CPU of 2 ms, which matters with software rendering eating the rest.
  If the wheels chatter, regenerate with a 0.002 s step (the step option).
  Rendering: one directional light, no shadows, no sky, primitive boxes only.
-->
<sdf version="1.8">
  <world name="basement_loop">
    <physics name="loop_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <dart><collision_detector>ode</collision_detector></dart>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.4 0.3 -0.85</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.86 0.84 0.78 1</ambient><diffuse>0.86 0.84 0.78 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="school_walls">
      <static>true</static>
      <link name="link">
        <collision name="outer_south_col">
          <pose>0 -10.1 1.2 0 0 0</pose>
          <geometry><box><size>20.4 0.2 2.4</size></box></geometry>
        </collision>
        <visual name="outer_south_vis">
          <pose>0 -10.1 1.2 0 0 0</pose>
          <geometry><box><size>20.4 0.2 2.4</size></box></geometry>
          <material><ambient>0.3 0.4 0.55 1</ambient><diffuse>0.3 0.4 0.55 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <collision name="outer_north_col">
          <pose>0 10.1 1.2 0 0 0</pose>
          <geometry><box><size>20.4 0.2 2.4</size></box></geometry>
        </collision>
        <visual name="outer_north_vis">
          <pose>0 10.1 1.2 0 0 0</pose>
          <geometry><box><size>20.4 0.2 2.4</size></box></geometry>
          <material><ambient>0.3 0.4 0.55 1</ambient><diffuse>0.3 0.4 0.55 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <collision name="outer_east_col">
          <pose>10.1 0 1.2 0 0 0</pose>
          <geometry><box><size>0.2 20 2.4</size></box></geometry>
        </collision>
        <visual name="outer_east_vis">
          <pose>10.1 0 1.2 0 0 0</pose>
          <geometry><box><size>0.2 20 2.4</size></box></geometry>
          <material><ambient>0.3 0.4 0.55 1</ambient><diffuse>0.3 0.4 0.55 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <collision name="outer_west_col">
          <pose>-10.1 0 1.2 0 0 0</pose>
          <geometry><box><size>0.2 20 2.4</size></box></geometry>
        </collision>
        <visual name="outer_west_vis">
          <pose>-10.1 0 1.2 0 0 0</pose>
          <geometry><box><size>0.2 20 2.4</size></box></geometry>
          <material><ambient>0.3 0.4 0.55 1</ambient><diffuse>0.3 0.4 0.55 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <collision name="block_core_col">
          <pose>0 0 1.2 0 0 0</pose>
          <geometry><box><size>14.62 14.62 2.4</size></box></geometry>
        </collision>
        <visual name="block_core_vis">
          <pose>0 0 1.2 0 0 0</pose>
          <geometry><box><size>14.62 14.62 2.4</size></box></geometry>
          <material><ambient>0.62 0.32 0.24 1</ambient><diffuse>0.62 0.32 0.24 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <collision name="block_south_0_col">
          <pose>0 -7.435 1.2 0 0 0</pose>
          <geometry><box><size>15.12 0.25 2.4</size></box></geometry>
        </collision>
        <visual name="block_south_0_vis">
          <pose>0 -7.435 1.2 0 0 0</pose>
          <geometry><box><size>15.12 0.25 2.4</size></box></geometry>
          <material><ambient>0.62 0.32 0.24 1</ambient><diffuse>0.62 0.32 0.24 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <collision name="block_north_0_col">
          <pose>0 7.435 1.2 0 0 0</pose>
          <geometry><box><size>15.12 0.25 2.4</size></box></geometry>
        </collision>
        <visual name="block_north_0_vis">
          <pose>0 7.435 1.2 0 0 0</pose>
          <geometry><box><size>15.12 0.25 2.4</size></box></geometry>
          <material><ambient>0.62 0.32 0.24 1</ambient><diffuse>0.62 0.32 0.24 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <collision name="block_east_0_col">
          <pose>7.435 0 1.2 0 0 0</pose>
          <geometry><box><size>0.25 14.62 2.4</size></box></geometry>
        </collision>
        <visual name="block_east_0_vis">
          <pose>7.435 0 1.2 0 0 0</pose>
          <geometry><box><size>0.25 14.62 2.4</size></box></geometry>
          <material><ambient>0.62 0.32 0.24 1</ambient><diffuse>0.62 0.32 0.24 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <collision name="block_west_0_col">
          <pose>-7.435 0 1.2 0 0 0</pose>
          <geometry><box><size>0.25 14.62 2.4</size></box></geometry>
        </collision>
        <visual name="block_west_0_vis">
          <pose>-7.435 0 1.2 0 0 0</pose>
          <geometry><box><size>0.25 14.62 2.4</size></box></geometry>
          <material><ambient>0.62 0.32 0.24 1</ambient><diffuse>0.62 0.32 0.24 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <visual name="start_line_vis">
          <pose>0 -8.78 0.001 0 0 0</pose>
          <geometry><box><size>0.1 2.44 0.002</size></box></geometry>
          <material><ambient>0.95 0.75 0.05 1</ambient><diffuse>0.95 0.75 0.05 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
