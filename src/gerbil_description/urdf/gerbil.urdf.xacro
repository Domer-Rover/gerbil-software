<?xml version="1.0"?>
<robot name="gerbil" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="common_properties.xacro" />
    <xacro:include filename="mobile_base.xacro" />
    <xacro:include filename="mobile_base.ros2_control.xacro" />

    <!-- Gazebo plugins, sensors and friction. Only when use_sim is true. -->
    <xacro:if value="${'$(arg use_sim)' in ('true', 'True', '1')}">
        <xacro:include filename="gerbil.gazebo.xacro" />
    </xacro:if>

</robot>