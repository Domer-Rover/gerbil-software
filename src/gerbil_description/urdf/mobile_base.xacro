<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ROBOT DIMENSIONS -->
    <!-- +X is forward. Drive wheels and ZED camera are at the front (+X);
         the caster trails at the rear (-X). Confirmed on hardware 2026-11-03. -->
    <xacro:property name="base_length" value="0.6096" />      <!-- 24 inches -->
    <xacro:property name="base_width" value="0.3048" />       <!-- 12 inches -->
    <xacro:property name="base_height" value="0.0635" />      <!-- 2.5 inches -->
    <xacro:property name="base_mass" value="6.8" />           <!-- ~15 lbs -->

    <xacro:property name="wheel_radius" value="0.04756" />    <!-- 95.11mm diameter -->
    <xacro:property name="wheel_length" value="0.03195" />    <!-- 31.95mm width -->
    <xacro:property name="wheel_mass" value="0.5" />          <!-- kg estimate -->
    <!-- 422.85mm center-to-center. Cross-checked 2026-11-03: the outer faces
         tape at 457.073mm (18 in), and 457.073 - 31.95 (one tyre width) =
         425.1, so the two measurements agree. -->
    <xacro:property name="wheel_separation" value="0.42285" />

    <!-- Wheel X position - near front edge of chassis -->
    <xacro:property name="wheel_x_offset" value="${base_length / 2.0 - 0.06}" />

    <!-- DRIVE RAIL ASSEMBLY (under the acrylic chassis, in a T)
         The long arm of the T runs fore-aft down the centreline; the top of
         the T is a transverse rail at the front carrying both motors. The
         motor bodies run inboard under the chassis and their output shafts
         protrude past the chassis sides, which is why wheel_separation
         (422.85mm) is wider than base_width (304.8mm).
         Motor body: goBILDA 5304 Yellow Jacket, 99.5:1.
         These are ESTIMATES for visualisation - tape-measure and correct. -->
    <xacro:property name="rail_thickness" value="0.02" />
    <xacro:property name="rail_long_length" value="0.45" />
    <xacro:property name="rail_long_width" value="0.05" />
    <xacro:property name="rail_cross_length" value="0.30" />
    <xacro:property name="rail_cross_width" value="0.05" />
    <xacro:property name="motor_diameter" value="0.037" />
    <xacro:property name="motor_length" value="0.095" />
    <!-- Motor sits just inboard of the wheel: its outer face meets the tyre's
         inner face, so the body reaches back under the chassis. -->
    <xacro:property name="motor_y" value="${wheel_separation / 2.0 - wheel_length / 2.0 - motor_length / 2.0}" />
    <!-- Rails hang below the chassis underside, which is base_link z=0 -->
    <xacro:property name="rail_z" value="${-rail_thickness / 2.0}" />

    <!-- BASE FOOTPRINT -->
    <link name="base_footprint" />

    <!-- BASE LINK -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
        </collision>

        <!-- T-rail: long arm down the centreline, running back from the
             transverse rail at the front -->
        <visual>
            <geometry>
                <box size="${rail_long_length} ${rail_long_width} ${rail_thickness}" />
            </geometry>
            <origin xyz="${wheel_x_offset - rail_long_length / 2.0} 0 ${rail_z}" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="${rail_long_length} ${rail_long_width} ${rail_thickness}" />
            </geometry>
            <origin xyz="${wheel_x_offset - rail_long_length / 2.0} 0 ${rail_z}" rpy="0 0 0" />
        </collision>

        <!-- T-rail: transverse arm at the front, carrying both motors -->
        <visual>
            <geometry>
                <box size="${rail_cross_width} ${rail_cross_length} ${rail_thickness}" />
            </geometry>
            <origin xyz="${wheel_x_offset} 0 ${rail_z}" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="${rail_cross_width} ${rail_cross_length} ${rail_thickness}" />
            </geometry>
            <origin xyz="${wheel_x_offset} 0 ${rail_z}" rpy="0 0 0" />
        </collision>

        <!-- Left drive motor, protruding outboard of the chassis -->
        <visual>
            <geometry>
                <cylinder radius="${motor_diameter / 2.0}" length="${motor_length}" />
            </geometry>
            <origin xyz="${wheel_x_offset} ${motor_y} 0" rpy="${pi / 2.0} 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${motor_diameter / 2.0}" length="${motor_length}" />
            </geometry>
            <origin xyz="${wheel_x_offset} ${motor_y} 0" rpy="${pi / 2.0} 0 0" />
        </collision>

        <!-- Right drive motor -->
        <visual>
            <geometry>
                <cylinder radius="${motor_diameter / 2.0}" length="${motor_length}" />
            </geometry>
            <origin xyz="${wheel_x_offset} ${-motor_y} 0" rpy="${pi / 2.0} 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${motor_diameter / 2.0}" length="${motor_length}" />
            </geometry>
            <origin xyz="${wheel_x_offset} ${-motor_y} 0" rpy="${pi / 2.0} 0 0" />
        </collision>

        <inertial>
            <mass value="${base_mass}" />
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
            <inertia ixx="${(1/12) * base_mass * (base_width*base_width + base_height*base_height)}"
                     ixy="0" ixz="0"
                     iyy="${(1/12) * base_mass * (base_length*base_length + base_height*base_height)}"
                     iyz="0"
                     izz="${(1/12) * base_mass * (base_length*base_length + base_width*base_width)}" />
        </inertial>
    </link>

    <!-- WHEEL MACRO -->
    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            </collision>
            <inertial>
                <mass value="${wheel_mass}" />
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <inertia ixx="${(1/12) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_length*wheel_length)}"
                         ixy="0" ixz="0"
                         iyy="${(1/12) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_length*wheel_length)}"
                         iyz="0"
                         izz="${(1/2) * wheel_mass * wheel_radius*wheel_radius}" />
            </inertial>
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="right" />
    <xacro:wheel_link prefix="left" />

    <!-- CASTER WHEEL -->
    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${wheel_radius / 2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius / 2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <inertial>
            <mass value="0.2" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
        </inertial>
    </link>

    <!-- IMU LINK -->
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.03 0.03 0.01" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="green">
                <color rgba="0 1 0 1" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.03 0.03 0.01" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.01" />
            <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
        </inertial>
    </link>

    <!-- ZED2i CAMERA LINK -->
    <!-- Named 'zed_camera_link' to match the ZED wrapper's TF frame,
         connecting the robot URDF tree to the ZED's internal frame chain -->
    <link name="zed_camera_link">
        <visual>
            <geometry>
                <box size="0.033 0.175 0.030" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="dark_grey">
                <color rgba="0.2 0.2 0.2 1" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.033 0.175 0.030" />
            </geometry>
        </collision>
        <inertial>
            <mass value="0.175" />
            <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
        </inertial>
    </link>

    <!-- JOINTS -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <!-- Drive wheels, at the front (+X) -->
    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <origin xyz="${wheel_x_offset} ${-wheel_separation / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <origin xyz="${wheel_x_offset} ${wheel_separation / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <!-- Caster, trailing at the rear (-X) -->
    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="${-wheel_x_offset} 0 ${-wheel_radius / 2.0}" rpy="0 0 0" />
    </joint>

    <!-- IMU centered on top of chassis not quite right, doesn't really matter, can add meshes later -->

    <!-- LIDAR LINK (LD19) -->
    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.035" length="0.045" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.035" length="0.045" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <inertial>
            <mass value="0.2" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
        </inertial>
    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link" />
        <child link="imu_link" />
        <origin xyz="0 0 ${base_height + 0.005}" rpy="0 0 0" />
    </joint>

    <!-- ZED camera at the front edge, on top of the chassis, facing forward (+X) -->
    <joint name="camera_joint" type="fixed">
        <parent link="base_link" />
        <child link="zed_camera_link" />
        <origin xyz="${base_length / 2.0 - 0.02} 0 ${base_height + 0.015}" rpy="0 0 0" />
    </joint>


    <!-- LIDAR, sitting on top of the ZED camera mount.
         Yaw is deliberately 0 while the real mounting angle is measured: the
         scan is then drawn in the LIDAR's own orientation, so the angle an
         object directly in front appears at IS the mounting offset. Set yaw to
         the negative of that angle. Previous guesses were -1.5708 (inherited
         from Capybara) and +1.5708; neither was ever confirmed.
         laser_filter.yaml's angular bounds are coupled to this value and its
         front-180 crop is disabled until the yaw is known.
         TODO - the XYZ still places the LIDAR at the chassis centre, but it is
         physically above the camera mount at the front (x ~ 0.2848). Measure
         and correct; until then obstacle ranges carry that offset as error. -->
    <joint name="lidar_joint" type="fixed">
        <parent link="base_link" />
        <child link="laser_frame" />
        <origin xyz="0 0 ${base_height + 0.023}" rpy="0 0 0" />
    </joint>

</robot>
