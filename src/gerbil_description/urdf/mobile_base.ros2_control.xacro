<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Hardware mode - mock for simulation, real for actual RoboClaw -->
    <xacro:arg name="use_mock_hardware" default="true" />
    <!-- Duty cycle = open-loop MOTOR COMMAND. The encoders are verified and
         the velocity PID is tuned and saved to NVM, so use_duty_cycle:=false
         (on-board velocity PID) is available and is what a serious Nav2 run
         should use. The default stays true because it has no surprising
         behaviour. Either way the encoders are still read, so wheel odometry
         is real in both modes. Duty cycle does not mean open-loop odometry. -->
    <xacro:arg name="use_duty_cycle" default="true" />
    <xacro:arg name="serial_port" default="/dev/gerbil_roboclaw" />
    <!-- use_sim false = real or mock hardware as selected above. true = the
         ign_ros2_control plugin drives the joints inside Gazebo Fortress, and
         use_mock_hardware is ignored. See oracle_sim/README.md in oracle-software. -->
    <xacro:arg name="use_sim" default="false" />
    <xacro:property name="sim_gazebo" value="${'$(arg use_sim)' in ('true', 'True', '1')}" />

    <ros2_control name="GerbilRoboClawSystem" type="system">
        <!-- Mock hardware for simulation or testing without actual RoboClaw -->
        <xacro:if value="${sim_gazebo}">
            <hardware>
                <plugin>ign_ros2_control/IgnitionSystem</plugin>
            </hardware>
        </xacro:if>

        <xacro:if value="${not sim_gazebo and '$(arg use_mock_hardware)' in ('true', 'True', '1')}">
            <hardware>
                <plugin>mock_components/GenericSystem</plugin>
            </hardware>
        </xacro:if>

        <!-- Real RoboClaw hardware (use when SSH'd into Jetson) -->
        <xacro:if value="${not sim_gazebo and '$(arg use_mock_hardware)' not in ('true', 'True', '1')}">
            <hardware>
                <plugin>gerbil_hw/RoboClawHardwareInterface</plugin>
                <param name="serial_port">$(arg serial_port)</param>
                <param name="use_duty_cycle">$(arg use_duty_cycle)</param>
            </hardware>
        </xacro:if>

        <!-- joints that are defined and do not change whether using mock hardware or actual roboclaw hardware -->
        <joint name="base_left_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10.0</param>
                <param name="max">10.0</param>
            </command_interface>
            <state_interface name="position"/>
            <param name="address">128</param>
            <param name="qppr">2786</param>  <!-- goBILDA 5304-8002-0100, 2786.2 PPR at the output shaft -->
            <param name="motor_type">M1</param>  <!-- M1 is the physical LEFT wheel -->
            <!-- Motor speed (rad/s) that maps to 100 percent duty cycle. Lower = more responsive -->
            <param name="max_duty_speed">18.85</param>
        </joint>
        <joint name="base_right_wheel_joint">
            <command_interface name="velocity">
                <param name="min">-10.0</param>
                <param name="max">10.0</param>
            </command_interface>
            <state_interface name="position"/>
            <param name="address">128</param>
            <param name="qppr">2786</param>  <!-- goBILDA 5304-8002-0100, 2786.2 PPR at the output shaft -->
            <param name="motor_type">M2</param>  <!-- M2 is the physical RIGHT wheel -->
            <!-- Motor speed (rad/s) that maps to 100 percent duty cycle. Lower = more responsive -->
            <param name="max_duty_speed">18.85</param>
        </joint>
    </ros2_control>
</robot>